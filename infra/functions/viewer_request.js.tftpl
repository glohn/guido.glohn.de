// CloudFront Function (viewer request, runtime cloudfront-js-2.0).
// - Redirects any other hostname (e.g. *.cloudfront.net) to ${domain}.
// - Maps directory URLs to their index.html ("/qr/" -> "/qr/index.html").
// - Adds the trailing slash to directory URLs ("/qr" -> "/qr/").
function handler(event) {
  var request = event.request;
  var uri = request.uri;
  var host = request.headers.host ? request.headers.host.value : "";

  if (host !== "${domain}") {
    return redirect("https://${domain}" + uri);
  }

  if (uri.charAt(uri.length - 1) === "/") {
    request.uri = uri + "index.html";
    return request;
  }

  var lastSegment = uri.substring(uri.lastIndexOf("/") + 1);
  if (lastSegment.indexOf(".") === -1) {
    return redirect(uri + "/");
  }

  return request;
}

function redirect(location) {
  return {
    statusCode: 301,
    statusDescription: "Moved Permanently",
    headers: { location: { value: location } },
  };
}
